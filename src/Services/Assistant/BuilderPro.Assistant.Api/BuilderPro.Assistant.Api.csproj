<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Assistant service (3a): a READ-ONLY product assistant. Microsoft Agent Framework agent on gpt-4o
    (Microsoft Foundry), with tools that call Catalog and Quotes AS THE CALLER. It never computes a
    price: amounts come from tools, and a price guard blocks any amount a tool didn't return.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../ServiceDefaults/BuilderPro.ServiceDefaults/BuilderPro.ServiceDefaults.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/BuilderPro.Security/BuilderPro.Security.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BuilderPro.Assistant.Api.Tests" />
  </ItemGroup>
</Project>
