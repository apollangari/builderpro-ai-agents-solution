{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    // The ONLY scopes a membership may carry. Anything else is rejected at write time.
    "Scopes": [ "quotes.read", "quotes.write", "scheduling.write", "catalog.admin" ],
    // What a self-registered customer gets through a store's sign-up link (never staff scopes).
    "CustomerScopes": [ "quotes.read", "quotes.write" ],
    // Bump Version whenever the consent wording on the sign-up page changes (Keycloak user profile).
    "ConsentWording": {
      "Version": "2026-11-13",
      "Text": "How may we contact you about your project? Phone calls / Text messages (SMS) / Calls and texts / Email only, no calls or texts. Message and data rates may apply. You can change this any time in your account."
    },
    // Storefronts. Id is the public slug in /signup?store=<id>. SignupEnabled=false closes the link.
    "Stores": [
      { "Id": "acme", "TenantId": "t-acme", "Name": "Acme Home Improvement", "SignupEnabled": true, "Features": [ "guided", "help-chat", "concierge" ] },
      { "Id": "globex", "TenantId": "t-globex", "Name": "Globex Building Supply", "SignupEnabled": true, "Features": [ "guided", "help-chat" ] }
    ],
    "SeedDevMemberships": false
  }
}
