{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    // The ONLY scopes a membership may carry. Anything else is rejected at write time.
    "Scopes": [ "quotes.read", "quotes.write", "scheduling.write", "catalog.admin" ],
    // What a self-registered customer gets through a store's sign-up link (never staff scopes).
    "CustomerScopes": [ "quotes.read", "quotes.write" ],
    // Storefronts. Id is the public slug in /signup?store=<id>. SignupEnabled=false closes the link.
    "Stores": [
      { "Id": "acme", "TenantId": "t-acme", "Name": "Acme Home Improvement", "SignupEnabled": true },
      { "Id": "globex", "TenantId": "t-globex", "Name": "Globex Building Supply", "SignupEnabled": true }
    ],
    "SeedDevMemberships": false
  }
}
