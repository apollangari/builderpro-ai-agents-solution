{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "MaxRequestBytes": 1048576,
    "MaxConcurrentConnections": 1000,
    "RateLimits": {
      "PublicPerMinute": 300,
      "DefaultPerMinute": 100,
      "WritesPerMinute": 30,
      "PublicPaths": [ "/api/auth-config", "/api/identity/stores" ]
    }
  },
  "ReverseProxy": {
    "Routes": {
      // Anonymous: the browser needs it BEFORE it can sign in.
      "auth-config": {
        "ClusterId": "me-api",
        "AuthorizationPolicy": "anonymous",
        "Order": 1,
        "Match": { "Path": "/api/auth-config" }
      },
      // 1g: a store's public info for its subdomain (name, sign-up open), before sign-in.
      "identity-stores": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Order": 1,
        "Match": { "Path": "/api/identity/stores/{id}" }
      },
      // Everything else under /api/me requires a valid token AT THE GATEWAY.
      "me": {
        "ClusterId": "me-api",
        "AuthorizationPolicy": "default",
        "Order": 10,
        "Match": { "Path": "/api/me/{**rest}" }
      },
      "me-root": {
        "ClusterId": "me-api",
        "AuthorizationPolicy": "default",
        "Order": 10,
        "Match": { "Path": "/api/me" }
      },
      "identity": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Order": 10,
        "Match": { "Path": "/api/identity/{**rest}" }
      },
      "catalog": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "default",
        "Order": 10,
        "Match": { "Path": "/api/catalog/{**rest}" }
      },
      "quotes-root": {
        "ClusterId": "quotes",
        "AuthorizationPolicy": "default",
        "Order": 10,
        "Match": { "Path": "/api/quotes" }
      },
      // 2n-f: projects live in the Quotes service.
      "projects-root": {
        "ClusterId": "quotes",
        "AuthorizationPolicy": "default",
        "Order": 10,
        "Match": { "Path": "/api/projects" }
      },
      "projects": {
        "ClusterId": "quotes",
        "AuthorizationPolicy": "default",
        "Order": 10,
        "Match": { "Path": "/api/projects/{**rest}" }
      },
      // 6a: deposits live in the Quotes service.
      "deposits": {
        "ClusterId": "quotes",
        "AuthorizationPolicy": "default",
        "Order": 10,
        "Match": { "Path": "/api/deposits/{**rest}" }
      },
      "quotes": {
        "ClusterId": "quotes",
        "AuthorizationPolicy": "default",
        "Order": 10,
        "Match": { "Path": "/api/quotes/{**rest}" }
      },
      "assistant": {
        "ClusterId": "assistant",
        "AuthorizationPolicy": "default",
        "Order": 10,
        "Match": { "Path": "/api/assistant/{**rest}" }
      }
    },
    "Clusters": {
      "me-api": {
        "Destinations": {
          // Logical name: resolved by service discovery (Aspire injects the real address).
          "d1": { "Address": "http://me-api" }
        }
      },
      "identity": {
        "Destinations": {
          "d1": { "Address": "http://identity" }
        }
      },
      "catalog": {
        "Destinations": {
          "d1": { "Address": "http://catalog" }
        }
      },
      "quotes": {
        "Destinations": {
          "d1": { "Address": "http://quotes" }
        }
      },
      "assistant": {
        "Destinations": {
          "d1": { "Address": "http://assistant" }
        }
      }
    }
  }
}
