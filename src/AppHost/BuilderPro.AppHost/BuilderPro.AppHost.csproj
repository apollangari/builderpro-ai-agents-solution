<Project Sdk="Aspire.AppHost.Sdk/13.6.5">
  <!--
    The AppHost is a .NET program whose only job is to describe and start the
    whole system locally: services, databases, identity, the Angular app.
    Run it (F5 / `dotnet run`) and open the Aspire dashboard it prints.
    The SDK version here MUST match $(AspireVersion) in Directory.Packages.props.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>builderpro-apphost</UserSecretsId>
    <!--
      ASPIRE010: we deliberately keep the dashboard and DCP as NuGet packages instead of the
      Aspire CLI bundle, so their versions stay pinned in Directory.Packages.props (that pin is
      what delivered the 13.6.5 security fixes). Revisit when we adopt the Aspire CLI.
      https://aspire.dev/diagnostics/aspire010/
    -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.Python" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Services/Me/BuilderPro.Me.Api/BuilderPro.Me.Api.csproj" />
    <ProjectReference Include="../../Gateway/BuilderPro.Gateway/BuilderPro.Gateway.csproj" />
    <ProjectReference Include="../../Services/Identity/BuilderPro.Identity.Api/BuilderPro.Identity.Api.csproj" />
    <ProjectReference Include="../../Services/Catalog/BuilderPro.Catalog.Api/BuilderPro.Catalog.Api.csproj" />
    <ProjectReference Include="../../Services/Quotes/BuilderPro.Quotes.Api/BuilderPro.Quotes.Api.csproj" />
    <ProjectReference Include="../../Services/Assistant/BuilderPro.Assistant.Api/BuilderPro.Assistant.Api.csproj" />
  </ItemGroup>
</Project>
