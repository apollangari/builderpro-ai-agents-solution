<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Store tests against a REAL Postgres (Testcontainers starts one in Docker, then throws it away).
    The API tests use in-memory stores; these prove the SQL itself: schema, tenant filters,
    transactions, idempotency. Needs Docker running.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Services/Identity/BuilderPro.Identity.Api/BuilderPro.Identity.Api.csproj" />
    <ProjectReference Include="../../src/Services/Catalog/BuilderPro.Catalog.Api/BuilderPro.Catalog.Api.csproj" />
    <ProjectReference Include="../../src/Services/Quotes/BuilderPro.Quotes.Api/BuilderPro.Quotes.Api.csproj" />
  </ItemGroup>
</Project>
