<!--
  Central Package Management: every NuGet version lives HERE, once.
  Projects reference packages WITHOUT a Version attribute.
  Upgrading a library = one line in one file, reviewed in one PR.

  Aspire rule (from Microsoft's 13.5 release notes): keep the SDK and ALL
  Aspire.* packages on the SAME version family. Never mix 13.5 and 13.6.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AspireVersion>13.6.5</AspireVersion>
    <!-- ServiceDiscovery versions with .NET (11.x), not with Aspire; 11.0.0 supports net10.0. -->
    <ServiceDiscoveryVersion>11.0.0</ServiceDiscoveryVersion>
  </PropertyGroup>
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Npgsql" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="$(AspireVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="$(ServiceDiscoveryVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="$(ServiceDiscoveryVersion)" />
  </ItemGroup>
  <ItemGroup Label="AI">
    <!-- Microsoft Agent Framework on Microsoft.Extensions.AI; the OpenAI client talks to Foundry's OpenAI v1 API. -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <!-- 3c: Model Context Protocol server (official C# SDK), Streamable HTTP. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.1" />
  </ItemGroup>
  <ItemGroup Label="Platform">
    <!-- Dapper: SQL stays hand-written and readable; Dapper only maps rows <-> objects. -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- Real Postgres in a throwaway container for store tests (needs Docker; CI runners have it). -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
